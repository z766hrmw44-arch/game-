<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Игра для тебя 💌</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #ff9a9e, #fecfef, #a18cd1);
    background-size: 300% 300%;
    animation: bg 10s ease infinite;
    font-family: 'Segoe UI', sans-serif;
    padding: 20px;
    overflow: hidden;
  }
  @keyframes bg { 0%,100%{background-position:0% 50%} 50%{background-position:100% 50%} }

  .card {
    background: rgba(255,255,255,0.92);
    border-radius: 24px;
    padding: 40px 30px;
    max-width: 420px; width: 100%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    animation: pop 0.5s ease;
  }
  @keyframes pop { from{transform:scale(0.8);opacity:0} to{transform:scale(1);opacity:1} }

  h1 { font-size: 26px; color: #d6336c; margin-bottom: 16px; }
  p { font-size: 18px; color: #444; margin-bottom: 24px; line-height: 1.5; }

  button {
    border: none; cursor: pointer;
    background: linear-gradient(135deg, #ff6b9d, #d6336c);
    color: white; font-size: 18px;
    padding: 14px 32px; border-radius: 50px;
    transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 8px 20px rgba(214,51,108,0.4);
    margin: 6px;
  }
  button:hover { transform: translateY(-2px) scale(1.05); }
  button:active { transform: scale(0.97); }

  .hidden { display: none; }
  .shake { animation: shake 0.4s; }
  @keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-8px)} 75%{transform:translateX(8px)} }

  /* Маленькая кнопка для 3 уровня */
  .tiny-btn {
    width: 22px; height: 22px;
    padding: 0; margin-top: 30px;
    border-radius: 50%;
    background: #ffb3c6;
    box-shadow: none;
    font-size: 10px;
    opacity: 0.7;
  }
  .tiny-btn:hover { opacity: 1; transform: scale(1.3); }

  .final-text {
    font-size: 22px; color: #d6336c; font-weight: bold;
    line-height: 1.6;
    animation: pop 0.6s ease;
  }
  .hearts { font-size: 34px; margin-top: 14px; animation: float 2s ease-in-out infinite; }
  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
</style>
</head>
<body>

<div class="card">
  <!-- УРОВЕНЬ 1 -->
  <div id="level1">
    <h1>Привет 💕</h1>
    <p>Это твой первый уровень —<br><b>поцеловать меня</b> 😚</p>
    <button onclick="nextLevel(1)">Сделано ✔</button>
  </div>

  <!-- УРОВЕНЬ 2 -->
  <div id="level2" class="hidden">
    <h1>Уровень 2 💭</h1>
    <p>Ты любишь меня?</p>
    <button onclick="wrong()">Нет</button>
    <button onclick="nextLevel(2)">Да ❤️</button>
  </div>

  <!-- УРОВЕНЬ 3 -->
  <div id="level3" class="hidden">
    <h1>Уровень 3 🔍</h1>
    <p>Найди маленькую кнопочку 😏</p>
    <button class="tiny-btn" onclick="final()" title="нажми меня">♥</button>
  </div>

  <!-- ФИНАЛ -->
  <div id="final" class="hidden">
    <p class="final-text">Я очень очень тебя люблю,<br>моя любовь 💖</p>
    <div class="hearts">💕💘💕</div>
  </div>
</div>

<script>
  function nextLevel(n) {
    document.getElementById('level' + n).classList.add('hidden');
    document.getElementById('level' + (n + 1)).classList.remove('hidden');
  }

  function wrong() {
    const p = document.querySelector('#level2 p');
    p.textContent = 'Неправильно! 😤 Подумай ещё раз...';
    p.style.color = '#d6336c';
    const card = document.querySelector('.card');
    card.classList.add('shake');
    setTimeout(() => card.classList.remove('shake'), 400);
  }

  function final() {
    document.getElementById('level3').classList.add('hidden');
    document.getElementById('final').classList.remove('hidden');
  }
</script>

</body>
</html>